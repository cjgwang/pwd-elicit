# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Required ---
# Bcrypt hash of the access password.
# Generate with: python -m src.cli set-password
# Uses bcrypt directly (compatible with Python 3.11+)
PASSWORD_HASH=

# --- Session ---
# How long (seconds) a session remains valid after the last request.
# Default: 3600 (1 hour)
SESSION_TTL_SECONDS=3600

# --- Rate limiting / lockout ---
# Number of consecutive failures before a client IP is locked out.
MAX_FAILED_ATTEMPTS=5
# How long (seconds) the lockout lasts.
LOCKOUT_SECONDS=300

# --- Model ---
# Any HuggingFace causal LM model name (will be downloaded on first run).
# Lightweight options: distilgpt2, gpt2, microsoft/phi-1_5
MODEL_NAME=distilgpt2
# Maximum tokens to generate per response.
MAX_NEW_TOKENS=200
# Device: "cpu" or "cuda"
MODEL_DEVICE=cpu

# --- API server ---
HOST=127.0.0.1
PORT=8000
